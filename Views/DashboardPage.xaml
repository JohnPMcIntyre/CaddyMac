<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaddyMac.Views.DashboardPage"
             Title="Dashboard">

    <VerticalStackLayout Padding="30" Spacing="20">

        <Label Text="Welcome to CaddyMac"
               FontSize="28"
               HorizontalOptions="Center" />

        <Button Text="Add Round"
        Clicked="OnAddRound"/>

        <Button Text="View Rounds"
        Clicked="OnViewRounds"/>

        <Button Text="Logout"
        Clicked="OnLogout"/>

    </VerticalStackLayout>

</ContentPage>